# Plate API configuration.
# Copy to server/.env and fill in real values. Never commit server/.env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB connection string. Plate is the source of truth for all user data.
# Atlas: mongodb+srv://<user>:<url-encoded-password>@<cluster>/plate?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/plate
MONGODB_URI=

# Auth0 tenant domain, without the https:// prefix.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# Auth0 API identifier. When set, the app requests an access token for this
# audience and the backend verifies it locally against the tenant JWKS, which is
# faster and avoids Auth0 /userinfo rate limits. Without it, tokens are opaque
# and every new token costs one /userinfo call (results are cached for 5 minutes).
# Must match EXPO_PUBLIC_AUTH0_AUDIENCE in Plate/.env.
AUTH0_AUDIENCE=https://api.plate.app

# Google AI Studio key. Powers all Plate AI: recipe generation, recommendations,
# substitutions, cooking chat, and food photo analysis.
GEMINI_API_KEY=

# ElevenLabs key. Powers speech-to-text and text-to-speech.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins. Leave empty in development to reflect
# the requesting origin. Set explicitly in production.
CORS_ORIGINS=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000

# Default ElevenLabs voice. Users can pick a different one in Voice settings.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TIMEOUT_MS=45000

# Unsplash access key for recipe photography. Gemini writes recipes but does not
# produce images. Without this key, recipe cards render Plate's own typographic
# cover instead — Plate never attaches a photo of a different dish.
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Grocery providers
# ---------------------------------------------------------------------------
# No grocery API is connected. Shopping search, price comparison, and ordering
# report as unavailable rather than showing invented prices or orders. To add a
# real integration, implement the contract in
# src/services/providers/types.js and register it in
# src/services/providers/registry.js, then add its credentials here.
