# Copy this file to .env and fill in values from MongoDB Atlas.
# Local Expo `npm start` auto-launches this server — keep these set.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/plate?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# For production, deploy this server (Railway/Render/Fly) and set the public
# URL as EXPO_PUBLIC_API_URL in the Expo / EAS build.
