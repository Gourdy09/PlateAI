# Plate mobile app configuration.
# Copy to Plate/.env and fill in real values. Never commit Plate/.env.
#
# Only EXPO_PUBLIC_* values belong here, and everything in this file ships inside
# the app bundle. API keys for Gemini, ElevenLabs, MongoDB, and Unsplash live in
# server/.env and are never sent to the client.

# Auth0 application (Native). The client id is public by design; the client
# secret must never appear here.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# Auth0 API identifier. Must match AUTH0_AUDIENCE in server/.env so the backend
# can verify the access token locally instead of calling Auth0 on every request.
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.plate.app

# Database connection used for email/password sign-in.
EXPO_PUBLIC_AUTH0_CONNECTION=Username-Password-Authentication

# Plate API base URL. Leave empty and the app derives it from the Expo dev host,
# which is what you want when running on a physical device on the same network.
# Set explicitly for a deployed backend, e.g. https://api.yourdomain.com
EXPO_PUBLIC_API_URL=
